# leerie-container: the AppArmor profile every local leerie container runs
# under (DESIGN §6 *A held-out evaluation runs alone, in a world that dies
# with it (I3)*, *What the runtime must allow*).
#
# nerdctl-default, plus exactly what the confinement shim
# (scripts/landlock_exec.py --isolate / --sandbox) needs to build a confined
# process's namespaces and mounts inside an unprivileged user namespace of its
# own: user namespaces, and each mount by type and target. Every /proc and
# /sys denial, and the signal and ptrace rules, are nerdctl-default's.
#
# `abi 4.0` because it mediates `userns`, `mqueue` and `io_uring`
# (nerdctl-default's `abi 3.0` does not). Loaded once by root, by the runtime
# install step (scripts/runtime-install.sh, runtime_install_apparmor):
#   sudo install -m 0644 scripts/apparmor/leerie-container /etc/apparmor.d/
#   sudo apparmor_parser -r -W /etc/apparmor.d/leerie-container
abi <abi/4.0>,
#include <tunables/global>

profile leerie-container flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  userns,
  mqueue,
  io_uring,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=leerie-container,
  signal (receive) peer=/usr/bin/rootlesskit,

  # The shim's mounts (enter_namespaces .. readonly_mounts), each by type
  # and target, in the order it makes them.
  mount options=(rw, rprivate) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /tmp/,
  # A private /dev (private_dev): a tmpfs, the allowed device nodes bound
  # into it (the bind rule below), its own /dev/shm and devpts.
  mount fstype=tmpfs options=(rw, nosuid, nodev, noexec) tmpfs -> /dev/,
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /dev/shm/,
  mount fstype=devpts options=(rw, nosuid, noexec) devpts -> /dev/pts/,
  # 0.43.0's shim binds the new devpts's ptmx over /dev/ptmx. This shim no
  # longer does, but the profile is the host's, shared by every leerie
  # version still running there, and a reload reaches running containers:
  # it keeps every rule a released shim needs (DESIGN §6 *What the runtime
  # must allow*, *The profile only grows*). The bind rule below matches
  # this one too; it is kept by name so the release pin reads it.
  mount options=(rw, bind) /dev/pts/ptmx -> /dev/ptmx,
  # The new root is staged on /tmp and its entries bound into it; after the
  # pivot, the grants beneath /tmp are carried in and every write grant is
  # bound onto itself (anywhere a grant may lie).
  mount options=(rw, bind) -> /**,
  mount options=(rw, rbind) -> /**,
  pivot_root,
  # A held-out sandbox's write grants are overlaid; they lie in the state
  # root.
  mount fstype=overlay overlay -> /leerie-state/**,
  # Every other mount made read-only.
  remount /,
  remount /**,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=leerie-container,
}
